<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>CanvasLifecycleHandlerPost</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Assign to Explori Sales Intelligence users who open the Canvas app on an Account; grants the Canvas lifecycle handler and Account read access, with no setup access.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Explori User</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
