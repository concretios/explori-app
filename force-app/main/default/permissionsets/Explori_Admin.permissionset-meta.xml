<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <applicationVisibilities>
        <application>Admin</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>SetupController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Explori_Manage_Config</name>
    </customPermissions>
    <description>Assign to Explori administrators who configure Explori Sales Intelligence; grants the setup controller, tab, and app plus the Explori_Manage_Config custom permission.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Explori Admin</label>
    <tabSettings>
        <tab>setup</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
